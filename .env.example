# Add real values only during a separately authorized live-acceptance step.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Access: this channel OR this role, always within DISCORD_GUILD_ID.
ALLOWED_CHANNEL_ID=
ALLOWED_ROLE_ID=
# Whether direct child threads inherit access from ALLOWED_CHANNEL_ID.
ALLOW_CHANNEL_THREADS=true

# No paid scans until explicitly enabled. Restart after configuration changes.
AI_DETECTION_ENABLED=false
AI_DETECTION_PROVIDER=pangram
PANGRAM_API_KEY=
PANGRAM_MODEL=pangram-4
# Estimate only. Confirm current model pricing before enabling.
PANGRAM_USD_PER_100_WORDS=0.05
