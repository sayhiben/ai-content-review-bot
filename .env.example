DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Access: this channel OR this role, always within DISCORD_GUILD_ID.
ALLOWED_CHANNEL_ID=
ALLOWED_ROLE_ID=
# Whether direct child threads inherit access from ALLOWED_CHANNEL_ID.
ALLOW_CHANNEL_THREADS=true

# Restart after configuration changes.
AI_DETECTION_ENABLED=false
# Persistent report database; Compose mounts /app/data.
CACHE_PATH=data/reports.sqlite
# A backend is offered only when enabled and its API key is configured.
PANGRAM_ENABLED=true
PANGRAM_API_KEY=
PANGRAM_MODEL=pangram-4
# Required cache version. Change this when Pangram updates the selected model.
PANGRAM_MODEL_VERSION=
# Estimate only. Confirm current model pricing before enabling.
PANGRAM_USD_PER_100_WORDS=0.05

GPTZERO_ENABLED=false
GPTZERO_API_KEY=
# Required API model version, also used to identify cached results.
GPTZERO_MODEL_VERSION=
# Optional estimated USD rate per 1,000 words; blank means cost unavailable.
GPTZERO_USD_PER_1000_WORDS=
