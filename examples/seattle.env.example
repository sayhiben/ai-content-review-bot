# Optional community mapping. Copy .env.example to .env first, then fill its
# access settings using this mapping. This file is documentation, not auto-loaded.

# The r/Seattle Discord server ID.
DISCORD_GUILD_ID=
# ID of #subreddit-chat (use the channel ID, not its name).
ALLOWED_CHANNEL_ID=
# ID of the exact "Subreddit Mod" role, not the general moderator role.
ALLOWED_ROLE_ID=
# Include direct child threads of #subreddit-chat.
ALLOW_CHANNEL_THREADS=true
